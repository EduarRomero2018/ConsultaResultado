# Configuración de referencia para Nginx en el servidor Lightsail.
# Copiar a /etc/nginx/sites-available/consultaresultado y enlazar en sites-enabled,
# ajustando `server_name` al dominio real.
#
# HTTPS: una vez el DNS del dominio apunte al servidor, correr:
#   sudo apt install certbot python3-certbot-nginx
#   sudo certbot --nginx -d tu-dominio.com --redirect
# Certbot agrega automáticamente el bloque `listen 443 ssl` (con las líneas
# `ssl_certificate`/`ssl_certificate_key`/etc. marcadas "# managed by Certbot")
# y un segundo server{} en el puerto 80 que redirige a HTTPS con 301 — no hace
# falta escribirlos a mano aquí. También instala un timer systemd
# (`certbot.timer`) que renueva el certificado automáticamente dos veces al día.

server {
    server_name tu-dominio-o-ip;

    # Nginx por defecto limita el body a 1MB. Esto debe cubrir un LOTE completo
    # (hasta 30 PDFs por request, ver upload.array('files', 30) en upload.js), no un
    # solo archivo: 30 archivos de ~5MB ya suman 150MB. Multer limita cada archivo
    # individual a 20MB como segunda capa de protección de memoria (memoryStorage
    # guarda el lote completo en RAM antes de procesarlo).
    client_max_body_size 150m;

    root /var/www/consultaresultado/frontend/dist;
    index index.html;

    # API: proxy reverso al backend Node/Express (PM2 lo mantiene en el puerto 5050)
    location /api/ {
        proxy_pass http://127.0.0.1:5050;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Frontend: SPA de React, fallback a index.html para las rutas del router
    # (/search, /upload, /login) que no existen como archivos físicos.
    location / {
        try_files $uri /index.html;
    }

    listen 80;
    # Tras correr certbot, esta línea la reemplaza por:
    #   listen 443 ssl; # managed by Certbot
    # y agrega las directivas ssl_certificate/ssl_dhparam debajo (ver nota arriba).
}
