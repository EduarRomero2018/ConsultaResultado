# Configuración de referencia para Nginx en el servidor Lightsail.
# Copiar a /etc/nginx/sites-available/consultaresultado y enlazar en sites-enabled,
# ajustando `server_name` al dominio/IP real.

server {
    listen 80;
    server_name tu-dominio-o-ip;

    # Nginx por defecto limita el body a 1MB, muy por debajo del límite de 20MB/archivo
    # que ya valida Multer en el backend. Sin esto, cualquier PDF > 1MB se rechaza en
    # Nginx (413) antes de llegar a Express, sin dejar rastro en los logs del backend.
    client_max_body_size 50m;

    root /var/www/consultaresultado/frontend/dist;
    index index.html;

    # API: proxy reverso al backend Node/Express (PM2 lo mantiene en el puerto 5050)
    location /api/ {
        proxy_pass http://127.0.0.1:5050;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Frontend: SPA de React, fallback a index.html para las rutas del router
    # (/search, /upload, /login) que no existen como archivos físicos.
    location / {
        try_files $uri /index.html;
    }
}
